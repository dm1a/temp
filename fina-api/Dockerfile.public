# Public build: pulls Python and uv from public registries -- used for local
# dev, testing, and this repo's own e2e suite (compose.e2e.yaml /
# compose.test.yaml both build this file explicitly via `dockerfile:`).
# For deployment inside the corporate network, use Dockerfile instead --
# it uses the internal registry mirror and Nexus PyPI proxy, and is what
# `docker build .` picks up by default (no -f needed).

FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock README.md ruff.toml ./
COPY packages ./packages
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM build AS test
RUN uv sync --frozen --extra dev --no-editable
COPY alembic.ini pytest.ini ./
COPY alembic ./alembic
COPY tests ./tests
ENV PATH="/app/.venv/bin:$PATH"
CMD ["pytest", "--strict-markers"]

FROM python:3.12-slim AS runtime
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home app
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY alembic.ini ./
COPY alembic ./alembic
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8000 9000
CMD ["python", "-m", "fina"]
