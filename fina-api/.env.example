# fina environment variables. Doubles as the Helm chart's reference for
# what to inject and how -- each line's comment states required/optional,
# format, and ConfigMap vs Secret. See README's "Configuration" section for
# the full explanation.
#
# For local dev: cp to .env, then run with `uv run --env-file .env ...`.

# --- Secrets (K8s Secret) ---
# postgresql+asyncpg:// URL; embeds DB credentials. Required unless
# FINA_DB_HOST/FINA_DB_USER/FINA_DB_NAME (below) and FINA_DB_PASSWORD are
# all set instead -- then leave unset; database_url is assembled from those.
FINA_DATABASE_URL=
# Required unless FINA_DATABASE_URL above already embeds the password, or
# every VAULT_* below is set -- then leave unset (Vault supplies it instead,
# under the key "db_password"; see README, VAULT_* is lowest-priority).
FINA_DB_PASSWORD=
# Required unless every VAULT_* below is set -- then leave unset (Vault
# supplies it instead; see README, VAULT_* is lowest-priority).
FINA_MCP_API_KEY=
# AppRole secret_id -- the sensitive half of the Vault credential pair.
VAULT_SECRET_ID=
# Required (S3_SECRET_KEY, LLM_KEY) or optional (S3_ACCESS_KEY) once
# FINA_API_MODE=false, to build the FINA Analyzer SDK client --
# S3_SECRET_KEY doubles as the MTS AudioFetcher SDK's own S3 secret too.
# Unused, and safe to leave unset, in API mode (see processing_mode.py).
FINA_S3_ACCESS_KEY=
FINA_S3_SECRET_KEY=
FINA_LLM_KEY=
FINA_MTS_SECRET_STRING=

# --- Config (K8s ConfigMap) ---
# Non-secret half of the FINA_DATABASE_URL alternative above (paired with
# FINA_DB_PASSWORD/Vault). All three, plus FINA_DB_NAME below, are required
# together whenever FINA_DATABASE_URL itself is left unset.
FINA_DB_HOST=
# Optional, int, default 5432.
FINA_DB_PORT=
FINA_DB_USER=
FINA_DB_NAME=
# Optional, bool, default false.
FINA_SQL_ECHO=
# Optional, ISO-8601 instant normalized to UTC+03:00, e.g. 2026-09-01T00:00:00+03:00.
# Set identically on every replica; stored discovery history takes precedence.
FINA_DISCOVERY_START_AT=
# Optional, int >= 1, default 5.
FINA_MAX_RETRY_ATTEMPTS=
# Optional, bool, default true. false also starts the background workers,
# which requires the FINA_S3_*/FINA_LLM_*/FINA_MTS_* settings below (see
# processing_mode.py and README's "Application entry point").
FINA_API_MODE=
# Vault endpoint and AppRole role_id (not FINA_-prefixed -- Vault's own
# naming convention). All five VAULT_* vars are optional together: set
# none, or all five including VAULT_SECRET_ID above.
VAULT_URL=
VAULT_ROLE_ID=
VAULT_ENGINE=
VAULT_SECRET_PATH=
# Optional, independent of the five above. Unset verifies the Vault
# server's TLS certificate against the standard CA bundle; a file path
# verifies against that CA bundle instead (the normal case in the
# corporate network); "false" disables verification -- local testing
# against a self-signed dev Vault only, never a real deployment.
VAULT_CA_BUNDLE=
# Required (all but ENDPOINT_URL) once FINA_API_MODE=false, same caveat as
# the FINA_S3_*/FINA_LLM_*/FINA_MTS_* secrets above.
FINA_S3_BUCKET_NAME=
FINA_S3_ENDPOINT_URL=
FINA_S3_CERT_PATH=
FINA_LLM_URL=
FINA_LLM_NAME=
FINA_STT_NAME=
FINA_LLM_CERT_PATH=
